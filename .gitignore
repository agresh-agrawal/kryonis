# Raw source assets and archived clutter. Kept on disk, out of history.
_archive/
Models i have added self/

# The built game models are the exception to the *.glb rule above: they are
# small (3 MB total), generated by tools/build-models.mjs, and the game does not
# run without them.
!public/models/*.glb
